# Copie para .env e preencha. O .env NUNCA vai para o Git.

# --- Banco -------------------------------------------------------------
# CouchDB local, subido com `docker compose up -d` (usuário e senha do
# docker-compose.yml, que só valem na sua máquina):
COUCHDB_URL=http://admin:admin@127.0.0.1:5984

# CouchDB no Railway (produção). Na sua máquina, com o admin, para init-db,
# seed-db, reset-db e reconciliar. No Vercel, o mesmo endereço com o usuário
# restrito torra_app — nunca o admin. Passo a passo em docs/deploy_vercel.md.
# COUCHDB_URL=https://admin:<senha-do-admin>@couchdb-production-ed47.up.railway.app

# Alternativa, se um dia migrar para o IBM Cloudant: a URL da credencial, ou,
# numa instância só com IAM, a URL sem usuário e senha mais a API key.
# COUCHDB_IAM_APIKEY=

COUCHDB_DATABASE=torra_terra

# --- Aplicação ---------------------------------------------------------
# Gere a sua com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-string-longa-e-aleatoria

# --- Testes (opcional) -------------------------------------------------
# Com ela, o pytest roda contra um CouchDB de verdade, num banco descartável
# criado e apagado a cada rodada. Sem ela, roda contra o dublê em memória.
# TEST_COUCHDB_URL=http://admin:admin@127.0.0.1:5984
